# Where the service listens. 5001 avoids every port the rest of the stack uses
# (8080/8081/8000/8090/9090/9093 and the client's 5173).
HOST=0.0.0.0
PORT=5001

# Mirrors the client's own 15 MB cap.
MAX_UPLOAD_BYTES=15728640

# Bearer token the client must send. Empty = no auth check (fine locally).
# When set, put the same value in client/.env as VITE_CONVERTER_TOKEN.
API_TOKEN=

# Comma-separated CORS allowlist; empty = any origin.
ALLOWED_ORIGINS=http://localhost:5173

# Directory holding Docling's model weights. Set it and run
# `python scripts/prefetch_models.py` to make the service fully offline —
# otherwise Docling downloads to its own cache on first use.
MODELS_DIR=

# OCR for scanned documents: +62 MB of weights and real time per page.
ENABLE_OCR=false

# Restores line breaks inside code/YAML blocks, but pulls a 611 MB model and
# costs ~150x the conversion time. Prefer submitting runbooks as Markdown.
ENABLE_CODE_ENRICHMENT=false

# Hard per-document ceiling.
CONVERSION_TIMEOUT_SECONDS=120
