# Which LLM provider to use: openai | anthropic | ollama
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Address of the Grafana MCP server exposed by the reference observability
# infrastructure module (Grafana MCP Server (SSE) -> http://localhost:8000/sse)
MCP_GRAFANA_URL=http://localhost:8000/sse
MCP_GRAFANA_TOOL_PREFIX=grafana_

# IMPORTANT: mcp-grafana can return 60+ tools (on-call scheduling, incidents,
# plugins, provisioning, snapshots, ...). The schema of EVERY registered tool
# is sent to the model on EVERY turn of the ReAct loop — with 65 tools this
# quickly exhausts the tokens-per-minute (TPM) rate limit, especially on
# lower API tiers. The list below is a curated subset actually needed for
# incident diagnosis (metrics, logs, traces, dashboards, alerts).
# Leaving this empty registers everything the server returns (not recommended
# in production).
# NOTE: find_error_pattern_logs and find_slow_requests are deliberately
# excluded — they are Grafana's "Sift" diagnostic tools, which are a
# Grafana Cloud-only feature (ML analysis backend hosted by Grafana Cloud).
# They are structurally unavailable to a self-hosted OSS Grafana instance,
# regardless of which plugins are installed locally — the "404 Plugin not
# found" seen during validation was not a missing local install, it was
# this deployment correctly reporting it has no access to that backend.
# No client-side or server-side configuration change fixes this short of
# connecting the stack to Grafana Cloud, so these two are left out for good.
# NOTE: list_alert_groups/get_alert_group were removed — despite the name,
# those are Grafana OnCall (on-call scheduling/escalation) tools, not
# firing alert rules, and this environment has no OnCall setup. The tool
# that actually reports firing alerts is alerting_manage_rules (operation
# "list", states=["firing"]); it also supports create/update/delete, but
# with --disable-write on the server it automatically drops into read-only
# mode with destructive operations hidden, so it is safe to expose here.
MCP_GRAFANA_TOOL_ALLOWLIST=list_datasources,check_datasources_health,query_prometheus,query_prometheus_histogram,list_prometheus_metric_names,list_prometheus_metric_metadata,list_prometheus_label_names,list_prometheus_label_values,query_loki_logs,query_loki_stats,query_loki_patterns,analyze_loki_labels,list_loki_label_names,list_loki_label_values,search_dashboards,get_dashboard_by_uid,get_dashboard_panel_queries,get_dashboard_summary,alerting_manage_rules

# Multi-source diagnosis (pods + Prometheus + Loki label discovery + queries)
# realistically needs more than a couple of tool calls, especially when the
# model has to recover from a wrong guess (bad label selector, wrong time
# format) and try again. 8 proved too tight during validation.
AGENT_MAX_ITERATIONS=12

# main.py polls the alerting tool for firing alerts and starts an
# investigation whenever the firing set changes (see
# agent_core/incident.py::alerts_signature). An alert that stays firing
# across many poll cycles triggers exactly one investigation, not one per
# cycle.
# If you're ALSO running webhook_server.py (recommended — see below and
# README, "Push vs. polling"), set this much higher (e.g. 300+) and use
# main.py purely as a reconciliation safety net for whatever the webhook
# missed, not as the primary trigger path.
AGENT_POLL_INTERVAL_SECONDS=60

# true = run exactly one investigation and exit (from whatever is firing
# right now, or the static example question if nothing is), instead of
# polling forever. Useful for a quick smoke test without waiting for a
# real alert.
AGENT_RUN_ONCE=false

# --- webhook_server.py (push-based alternative/complement to polling) ---
# Alertmanager POSTs directly here when an alert group starts firing,
# instead of us polling for it — see README, "Push vs. polling", for the
# full design and the Alertmanager receiver config to add on the
# infrastructure side.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8090

# If set, /alerts/webhook requires "Authorization: Bearer <this value>".
# Alertmanager's webhook_configs support sending this natively via
# http_config.authorization.credentials. Leave empty only for local dev on
# localhost — never for an endpoint reachable from outside your machine.
WEBHOOK_SHARED_SECRET=
# Where finished investigations are saved as JSON files (title,
# error_sources, problem, remediations, raw_diagnosis) — see
# agent_core/report.py. Relative paths are resolved against wherever the
# process was started from.
REPORT_OUTPUT_DIR=./reports

# Mutable-status counterpart to REPORT_OUTPUT_DIR (SQLite, see
# agent_core/reports_store.py) — what the /reports* endpoints below read
# from and write status changes to.
REPORTS_DB_PATH=./reports/reports.db

# --- /reports* endpoints (client web panel) ---
# If set, GET/PATCH /reports* requires "Authorization: Bearer <this
# value>". Separate secret from WEBHOOK_SHARED_SECRET above — Alertmanager
# and the web panel are different callers. Leave empty only for local dev.
CLIENT_API_TOKEN=

# Comma-separated origins allowed to call /reports* (CORS). Empty = allow
# any origin (fine while this is one developer's machine talking to one
# local agent). Narrow it down once the client isn't only localhost, e.g.:
# CLIENT_ALLOWED_ORIGINS=http://localhost:5173
CLIENT_ALLOWED_ORIGINS=

# Empty = no restriction on namespaces for the kubectl tools.
# Recommended in practice, e.g.: otel-demo,monitoring
KUBECTL_ALLOWED_NAMESPACES=otel-demo
