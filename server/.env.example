IDAR_EMBEDDING_PROVIDER=ollama
IDAR_EMBEDDING_MODEL=qwen3-embedding:0.6b
IDAR_OLLAMA_URL=http://localhost:11434
IDAR_QDRANT_URL=http://localhost:6333
IDAR_COLLECTION_ALIAS=kb_active
IDAR_QUERY_INSTRUCTION=Given a technical question about cloud-native infrastructure incidents, retrieve relevant documentation passages that help diagnose or resolve the issue
IDAR_CHUNK_MAX_TOKENS=600
IDAR_CHUNK_OVERLAP_TOKENS=80
IDAR_BREADCRUMBS=true
# CORS: originy panelu po przecinku (Vite dev + panel z kontenera); pusta = dowolny origin
IDAR_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Opcjonalny token Bearer dla /api/documents i /api/search (pusty = bez uwierzytelniania)
IDAR_API_TOKEN=
# Ile razy i co ile sekund ponawiać start, gdy Ollama/Qdrant jeszcze wstają
IDAR_STARTUP_RETRIES=30
IDAR_STARTUP_RETRY_SECONDS=2
